{
  "name": "rafchu-api",
  "version": "0.1.0",
  "private": true,
  "description": "Pokémon card metadata + pricing API. Phase 0: private backend powering the Rafchu app.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --experimental-specifier-resolution=node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:bootstrap": "tsx scripts/bootstrap-db.ts",
    "ingest:pokemontcg": "tsx scripts/run-ingest.ts pokemontcg",
    "ingest:ebay": "tsx scripts/run-ingest.ts ebay",
    "ingest:all": "tsx scripts/run-ingest.ts all"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "fastify": "^5.1.0",
    "postgres": "^3.4.5",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
