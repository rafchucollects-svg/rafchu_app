# ---------- Server ----------
PORT=8080
LOG_LEVEL=info
NODE_ENV=development

# ---------- Postgres ----------
# Supabase: Project Settings -> Database -> Connection string -> URI (use the "Transaction" pooler on 6543 for serverless,
# or the "Session" pooler / direct connection on 5432 for long-running workers.)
DATABASE_URL=postgres://postgres:password@localhost:5432/rafchu

# ---------- pokemontcg.io ----------
# Optional but strongly recommended. Free: https://dev.pokemontcg.io
# Without a key you're limited to ~30 req/min; with one you get ~20k req/day.
POKEMONTCG_API_KEY=

# ---------- eBay Browse API ----------
# https://developer.ebay.com  (Production keyset)
# Client credentials OAuth flow: we exchange these for a short-lived access token.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# "EBAY_US" | "EBAY_GB" | "EBAY_DE" etc. Used for marketplace header.
EBAY_MARKETPLACE=EBAY_US

# ---------- Ingest tuning ----------
# Cap the eBay ingestor to the N most-popular cards per run to stay under free quotas.
EBAY_TOP_N_CARDS=2000
# Paginate pokemontcg.io; 250 is their max page size.
PTCG_PAGE_SIZE=250
