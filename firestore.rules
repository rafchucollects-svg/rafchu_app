rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Admin check
    //
    // Primary: document exists at /admins/{uid}. Easy to grant/revoke from
    // the Firebase console without a code deploy. To grant admin, create
    // a doc at admins/<uid> with any content (e.g. { role: "owner" }).
    //
    // Fallback: legacy email claim. Kept temporarily to avoid lockout while
    // migrating. Once you've confirmed an admins/{uid} doc works for you,
    // remove the email branch entirely (see TODO below).
    // ------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        // TODO: remove this email fallback once an admins/{uid} doc is in place.
        (request.auth.token.email == 'rafchucollects@gmail.com' && request.auth.token.email_verified == true)
      );
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admins collection — who is an admin.
    // Only admins can read/modify; first admin must be seeded manually from
    // the Firebase console (Firestore UI) while the email fallback is still
    // in place.
    match /admins/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isAdmin();
    }

    // User profiles - readable by all (for shared links and marketplace).
    // Owners may edit their own profile but MUST NOT be able to self-grant
    // privileged fields. `isAdmin` (used by admin UI + storage rules) and
    // `vendorAccess` (the subscription object) can only be set by an admin.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId)
                        && !request.resource.data.keys().hasAny(['isAdmin', 'vendorAccess']))
                     || isAdmin();
      allow update: if (isOwner(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'vendorAccess']))
                     || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Vendor inventory collections owned by each authenticated user.
    match /collections/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // Collector collections owned by each authenticated user.
    match /collector_collections/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Collector wishlists owned by each authenticated user.
    match /collector_wishlists/{userId} {
      // Wishlists are readable by authenticated users (for insights)
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Conversations between users.
    // Read/update/delete require membership in the EXISTING participants list,
    // and the participant list is immutable on update so a signed-in user can
    // not insert themselves into someone else's conversation.
    match /conversations/{conversationId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.participants[0] != request.resource.data.participants[1];
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;
      allow delete: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
    }

    // Messages within conversations - only participants can read/write
    match /conversations/{conversationId}/messages/{messageId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
      allow read: if isParticipant();
      allow create: if isParticipant() && request.resource.data.senderId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isParticipant() && resource.data.senderId == request.auth.uid
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isParticipant() && resource.data.senderId == request.auth.uid;
    }

    // Transactions - legacy flat collection (marketplace P2P trades).
    // Participants can read/write; admin has full access.
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.buyerId ||
        request.auth.uid == resource.data.sellerId ||
        isAdmin()
      );
      function validParties() {
        let data = request.resource.data;
        let participants = get(/databases/$(database)/documents/conversations/$(data.conversationId)).data.participants;
        return data.buyerId != data.sellerId && data.buyerId in participants && data.sellerId in participants;
      }
      function validStatus() {
        let data = request.resource.data;
        return (data.buyerConfirmedAt != null && data.sellerConfirmedAt != null && data.status == 'completed') ||
          (data.buyerConfirmedAt != null && data.sellerConfirmedAt == null && data.status == 'buyer_confirmed') ||
          (data.sellerConfirmedAt != null && data.buyerConfirmedAt == null && data.status == 'seller_confirmed');
      }
      allow create: if isSignedIn() && validParties() && validStatus() && (
        (request.auth.uid == request.resource.data.buyerId && request.resource.data.buyerConfirmedAt == request.time && request.resource.data.sellerConfirmedAt == null) ||
        (request.auth.uid == request.resource.data.sellerId && request.resource.data.sellerConfirmedAt == request.time && request.resource.data.buyerConfirmedAt == null)
      );
      allow update: if isSignedIn() && validStatus() && (
        (request.auth.uid == resource.data.buyerId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'buyerConfirmedAt']) && request.resource.data.buyerConfirmedAt == request.time) ||
        (request.auth.uid == resource.data.sellerId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sellerConfirmedAt']) && request.resource.data.sellerConfirmedAt == request.time)
      );
      allow delete: if isAdmin();
    }

    // Ratings - readable by anyone (for displaying on profiles), writable once by transaction participants
    match /ratings/{ratingId} {
      allow read: if true; // Public read for vendor ratings display
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.fromUserId &&
        ratingId == request.resource.data.transactionId + '_' + request.auth.uid &&
        request.resource.data.thumbsUp is bool &&
        request.resource.data.keys().hasOnly(['transactionId', 'fromUserId', 'toUserId', 'thumbsUp', 'createdAt']) &&
        request.resource.data.createdAt == request.time &&
        get(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.status == 'completed' && (
          (request.auth.uid == get(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.buyerId && request.resource.data.toUserId == get(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.sellerId) ||
          (request.auth.uid == get(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.sellerId && request.resource.data.toUserId == get(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.buyerId)
        );
    }

    // Vendor Transactions - for logging sales in My Inventory
    match /vendor_transactions/{transactionId} {
      allow read: if isSignedIn() &&
        request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.userId;
    }

    // Transaction Log - subcollection for vendor transaction history
    match /transactions/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId);
    }

    // Inventory Snapshots - subcollection for vendor inventory snapshots
    match /inventory_snapshots/{userId}/snapshots/{snapshotId} {
      allow read, write, delete: if isOwner(userId);
    }

    // Vendor Access Requests - users can create and read their own, admins can read/update all
    match /vendorAccessRequests/{requestId} {
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.userId;
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow update: if isAdmin();
      allow list: if isAdmin();
    }

    // Feedback submissions - users can create, admins can read/update all
    match /feedback/{feedbackId} {
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.userId;
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow update: if isAdmin();
      allow list: if isAdmin();
    }

    // Community Image Submissions - users can create, admins can read/update all
    match /communityImageSubmissions/{submissionId} {
      // Any authenticated user can submit
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.submittedBy;

      // Users can read their own submissions, admins can read all
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.submittedBy || isAdmin()
      );

      // Only admins can update/delete (for approval/rejection)
      allow update, delete: if isAdmin();

      // Admins can list all submissions
      allow list: if isAdmin();
    }

    // Approved Community Images - public read, admin write
    match /approvedCommunityImages/{cardId} {
      // Anyone can read approved images metadata
      allow read: if true;

      // Only admins can write/update/delete
      allow write, delete: if isAdmin();
    }

    // Community Images - For approved images used in card database
    match /community_images/{imageId} {
      // Public read for approved images
      allow read: if true;

      // Only admins and Cloud Functions can write
      allow write: if isAdmin();
    }

    // Trade Offers - Shareable trade offer links
    match /tradeOffers/{offerId} {
      // Public read so shared links work for anyone
      allow read: if true;

      // Authenticated users can create their own offers
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.vendorId;

      // Owners can update/delete their offers
      allow update, delete: if isSignedIn() &&
        request.auth.uid == resource.data.vendorId;
    }

    // Pending Deals - Synced across devices for trade/buy calculators
    match /pendingDeals/{userId} {
      // Only owner can read/write their pending deals
      allow read, write: if isOwner(userId);
    }

    // Card Database Cache - public card metadata used by the public search UI;
    // Cloud Functions remain the only writers.
    match /card_database/{cardKey} {
      allow read: if true;

      // No direct writes from clients - only Cloud Functions can update
      // (Cloud Functions bypass security rules by default when using Admin SDK)
      allow write: if false;
    }

    // Public, non-sensitive search metadata generated by Cloud Functions.
    match /system/{documentId} {
      allow read: if documentId == 'set_catalog';
      allow write: if false;
    }

    // Update Logs - Cloud Functions only
    match /update_logs/{logId} {
      // Admins can read logs for monitoring
      allow read: if isAdmin();

      // No direct writes from clients - only Cloud Functions can write
      allow write: if false;
    }

    // Expenses - subcollection for business expense tracking
    match /expenses/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId);
    }

    // Expense Preferences - OCR correction history for learning
    match /expense_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Expense Shows - subcollection for show schedule and per diems
    match /expense_shows/{userId}/entries/{showId} {
      allow read, write: if isOwner(userId);
    }

    // Expense Payouts - subcollection for reimbursement payout records
    match /expense_payouts/{userId}/entries/{payoutId} {
      allow read, write: if isOwner(userId);
    }

    // Expense Recurring - subcollection for recurring expense schedules
    // (e.g. monthly rent, subscriptions). Auto-posts into /expenses on due date.
    match /expense_recurring/{userId}/entries/{recurringId} {
      allow read, write: if isOwner(userId);
    }

    // Tax Config - per-user tax settings
    match /tax_config/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Tax Purchases - subcollection for purchase diary
    match /tax_purchases/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId);
    }

    // Tax Shareholder - subcollection for shareholder loan ledger
    match /tax_shareholder/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId);
    }

    // Bank Transactions - subcollection for Wise CSV imports
    match /bank_transactions/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId);
    }

    // Bill of Sale - subcollection for signed kauppakirja metadata
    match /bill_of_sale/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId);
    }

    // Other Revenue - subcollection for non-card income journal
    match /other_revenue/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId);
    }

    // Consignors - registry of people who consign inventory to the vendor
    match /consignors/{userId}/entries/{consignorId} {
      allow read, write: if isOwner(userId);
    }

    // Consignor Payouts - ledger of payouts made to consignors
    match /consignor_payouts/{userId}/entries/{payoutId} {
      allow read, write: if isOwner(userId);
    }

    // Read models contain allowlisted display data only; functions are writers.
    match /public_profiles/{uid} { allow read: if true; }
    match /public_inventories/{uid} {
      allow read: if get(/databases/$(database)/documents/collections/$(uid)).data.shareEnabled == true && (
        exists(/databases/$(database)/documents/admins/$(uid)) || (
          get(/databases/$(database)/documents/users/$(uid)).data.get('vendorAccess', {}).get('enabled', false) == true &&
          get(/databases/$(database)/documents/users/$(uid)).data.get('vendorAccess', {}).get('status', '') == 'active'
        )
      );
    }
    match /public_collections/{uid} {
      allow read: if get(/databases/$(database)/documents/collector_collections/$(uid)).data.shareEnabled == true;
    }
    match /public_vendor_stats/{uid} { allow read: if true; }
    match /public_wishlist_counts/{key} { allow read: if isSignedIn(); }
    match /tax_loss_carry/{uid}/years/{id} { allow read, write: if isOwner(uid); }
    match /tax_mileage/{uid}/trips/{id} { allow read, write: if isOwner(uid); }
    match /tax_benefits/{uid}/entries/{id} { allow read, write: if isOwner(uid); }
    match /collections/{uid}/trash/{id} { allow read, write: if isOwner(uid); }
    match /collector_collections/{uid}/trash/{id} { allow read, write: if isOwner(uid); }

    // Default deny for all other documents unless explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
