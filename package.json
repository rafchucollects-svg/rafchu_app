{
  "name": "rafchu-marketplace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src functions/*.js tests/*.mjs scripts/*.js vite.config.js eslint.config.js",
    "preview": "vite preview",
    "emulators": "npm exec --yes --package firebase-tools@15.29.0 -- firebase emulators:start --only auth,firestore,functions,storage --project demo-rafchu-review",
    "emulators:export": "firebase emulators:export ./emulator-data",
    "emulators:import": "firebase emulators:start --import=./emulator-data",
    "seed": "node scripts/seed-emulator-data.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "npm exec --yes --package firebase-tools@15.29.0 -- firebase emulators:exec --only firestore --project demo-rafchu-review \"node --test tests/firestore.rules.test.mjs\""
  },
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "firebase": "^12.3.0",
    "framer-motion": "^12.23.22",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.545.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.26.0",
    "signature_pad": "^5.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^28.0.0",
    "justtcg-js": "^0.1.16",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.13",
    "vite": "^7.1.7",
    "vitest": "^4.0.18"
  }
}
