# Template for local Cloud Functions development.
# Copy this file to `.env.local` and fill in real values.
# .env.local is gitignored — NEVER commit real keys.
#
# For production, these values live in Google Secret Manager (set via
# `firebase functions:secrets:set <NAME>`) and do NOT need to be in this file.
# This file is only for running the Functions emulator locally.

POKEPRICE_KEY=
RAPIDAPI_KEY=
JUSTTCG_KEY=
GEMINI_KEY=

# Gmail app password (used for sending new-message email notifications)
GMAIL_EMAIL=
GMAIL_PASSWORD=
