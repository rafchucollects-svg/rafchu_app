# Firebase Configuration (optional - defaults are baked into the code)
# Only needed if you want to override the default production config
# Example: Use a different Firebase project for local development

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Set to "true" to connect to local Firebase Emulators (requires: firebase emulators:start)
VITE_USE_EMULATORS=false

# ---- Cloud Functions Config (set via Firebase CLI, not .env) ----
# Gemini API Key for receipt OCR (Expense Tracker feature)
# 1. Get a free key at https://aistudio.google.com/apikey
# 2. Set it: firebase functions:config:set gemini.key="YOUR_GEMINI_API_KEY"
# 3. For local dev, create functions/.runtimeconfig.json:
#    { "gemini": { "key": "YOUR_GEMINI_API_KEY" } }
