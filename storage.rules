rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Admin check — mirrors firestore.rules. Admin status lives in the
    // admins/{uid} collection (NOT the client-writable users.isAdmin field,
    // which any user could set on their own profile). Email fallback kept in
    // parity with Firestore during migration.
    function isStorageAdmin() {
      return request.auth != null && (
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'rafchucollects@gmail.com'
      );
    }

    function isConversationParticipant(conversationId) {
      return request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants;
    }

    // Profile pictures - users can only upload/read their own
    match /profile-pictures/{userId} {
      allow read: if true; // Public read for profile pictures
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Message images - only conversation participants may read/write, and
    // uploads are capped and restricted to image content types.
    match /message-images/{conversationId}/{fileName} {
      allow read: if isConversationParticipant(conversationId);
      allow write: if isConversationParticipant(conversationId)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Community image submissions (pending review)
    match /community-images/pending/{filename} {
      // Authenticated users can upload images for review
      allow create: if request.auth != null 
                    && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                    && request.resource.contentType.matches('image/.*');
      
      // Anyone can read (for preview in admin panel)
      allow read: if true;
      
      // Only admins can delete pending images
      allow delete: if isStorageAdmin();
    }
    
    // Approved community images (public)
    match /community-images/approved/{filename} {
      // Anyone can read approved images
      allow read: if true;
      
      // Only admins can write/delete approved images
      allow write, delete: if isStorageAdmin();
    }

    // Card images - vendor/collector supplied art for cards in their own
    // inventory (used by CardImageReplacer). Mirrors manual-cards.
    match /card-images/{userId}/{filename} {
      allow create, write: if request.auth != null
                           && request.auth.uid == userId
                           && request.resource.size < 5 * 1024 * 1024
                           && request.resource.contentType.matches('image/.*');
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Manual card images - users can upload their own (bypasses admin approval)
    match /manual-cards/{userId}/{filename} {
      // Users can only upload to their own folder
      allow create, write: if request.auth != null 
                           && request.auth.uid == userId
                           && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                           && request.resource.contentType.matches('image/.*');
      
      // Anyone can read (for displaying in shared collections)
      allow read: if true;
      
      // Users can delete their own images
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Expense receipt images - users can only access their own
    match /expense_receipts/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, write: if request.auth != null 
                           && request.auth.uid == userId
                           && request.resource.size < 10 * 1024 * 1024
                           && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Card scan photos - users can only access their own
    match /card_scans/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, write: if request.auth != null 
                           && request.auth.uid == userId
                           && request.resource.size < 10 * 1024 * 1024
                           && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Tax receipt images - users can only access their own
    match /tax_receipts/{userId}/{entryId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, write: if request.auth != null 
                           && request.auth.uid == userId
                           && request.resource.size < 10 * 1024 * 1024
                           && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Bill of Sale PDFs - users can only access their own
    match /bill_of_sale/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, write: if request.auth != null 
                           && request.auth.uid == userId
                           && request.resource.size < 20 * 1024 * 1024
                           && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
