{
  "manifest_version": 3,
  "name": "Rafchu Cardmarket Companion",
  "version": "0.3.5",
  "description": "Capture exact English/Japanese variant offers for manual review in Rafchu.",
  "permissions": [
    "storage",
    "pageCapture"
  ],
  "host_permissions": [
    "https://www.cardmarket.com/en/Pokemon/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.cardmarket.com/en/Pokemon/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://rafchu-tcg-app.firebaseapp.com/*",
        "https://rafchu-tcg-app.web.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
